rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    match /users/{u} {
      allow read: if signedIn() && uid() == u;

      allow create: if signedIn()
        && uid() == u
        && request.resource.data.keys().hasOnly([
             'username',
             'buildings',
             'createdAt'
           ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 50
        && request.resource.data.buildings is list
        && request.resource.data.buildings.size() == 0
        && request.resource.data.createdAt is int;

      allow update: if signedIn()
        && uid() == u
        && request.resource.data.keys().hasOnly([
             'username',
             'buildings',
             'createdAt'
           ])
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['buildings'])
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.buildings is list
        && request.resource.data.buildings.size() <= 50;

      allow delete: if false;
    }
    match /buildings/{bid} {
      function cfg() { return get(/databases/$(database)/documents/buildings/$(bid)).data; }
      function hasCfg() { return exists(/databases/$(database)/documents/buildings/$(bid)); }
      function isMember() { return signedIn() && exists(/databases/$(database)/documents/buildings/$(bid)/members/$(uid())); }
      function myRoles() { return get(/databases/$(database)/documents/buildings/$(bid)/members/$(uid())).data.roles; }
      function isAdmin() { return signedIn() && hasCfg() && (uid() == cfg().adminUid || (isMember() && myRoles().hasAny(['admin']))); }
      function canEditMonth() { return isAdmin() || (isMember() && myRoles().hasAny(['treasurer','water'])); }
      allow read: if true;
      allow create: if signedIn() && request.resource.data.adminUid == uid();
      allow update, delete: if isAdmin();
      match /members/{m} {
        allow read: if isMember() || isAdmin();
        allow create: if (uid() == m && request.resource.data.roles.size() == 0) || isAdmin();
        allow update: if isAdmin() || (uid() == m && request.resource.data.roles == resource.data.roles);
        allow delete: if isAdmin();
      }
      match /flats/{flat} {
        allow read: if isMember();
        allow create: if isAdmin() || (signedIn() && !hasCfg());
        allow update: if isAdmin()
          || (isMember()
              && resource.data.claimedByUid == null
              && request.resource.data.claimedByUid == uid());
        allow delete: if isAdmin();
      }
      match /waterPeriods/{p} {
        allow read: if isMember();
        allow write: if canEditMonth() || (signedIn() && !hasCfg());
      }
      match /maintPeriods/{p} {
        allow read: if isMember();
        allow write: if canEditMonth() || (signedIn() && !hasCfg());
      }
      match /activities/{a} {
        allow read: if isMember();
        allow create: if isAdmin();
        allow update: if isAdmin() || isMember();
        allow delete: if isAdmin();
      }
      match /costPresets/{p} {
        allow read: if isMember();
        allow write: if canEditMonth();
      }
    }
  }
}
