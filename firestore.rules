rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // ── /users/{u} ── SEC-01: owner-only, schema-validated ──
    match /users/{u} {
      allow read: if signedIn() && uid() == u;

      allow create: if signedIn()
        && uid() == u
        && request.resource.data.keys().hasOnly([
             'username',
             'buildings',
             'createdAt'
           ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 50
        && request.resource.data.buildings is list
        && request.resource.data.buildings.size() == 0
        && request.resource.data.createdAt is int;

      allow update: if signedIn()
        && uid() == u
        && request.resource.data.keys().hasOnly([
             'username',
             'buildings',
             'createdAt'
           ])
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['buildings'])
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.buildings is list
        && request.resource.data.buildings.size() <= 50;

      allow delete: if false;
    }

    // ── /buildings/{bid} ──
    match /buildings/{bid} {
      function cfg() { return get(/databases/$(database)/documents/buildings/$(bid)).data; }
      function hasCfg() { return exists(/databases/$(database)/documents/buildings/$(bid)); }
      function isMember() { return signedIn() && exists(/databases/$(database)/documents/buildings/$(bid)/members/$(uid())); }
      function myRoles() { return get(/databases/$(database)/documents/buildings/$(bid)/members/$(uid())).data.roles; }
      function isAdmin() { return signedIn() && hasCfg() && (uid() == cfg().adminUid || (isMember() && myRoles().hasAny(['admin']))); }

      // SEC-04: role-specific edit helpers (replaces canEditMonth)
      function hasRole(role) { return isMember() && myRoles().hasAny([role]); }
      function canEditWater() { return isAdmin() || hasRole('water'); }
      function canEditMaint() { return isAdmin() || hasRole('treasurer'); }

      allow read: if true;
      allow create: if signedIn() && request.resource.data.adminUid == uid();
      allow update, delete: if isAdmin();

      // ── members ──
      match /members/{m} {
        allow read: if isMember() || isAdmin();
        allow create: if (uid() == m && request.resource.data.roles.size() == 0) || isAdmin();
        // DB-09: restrict self-update to safe fields only; roles are immutable by self
        allow update: if isAdmin()
          || (uid() == m
              && request.resource.data.roles == resource.data.roles
              && request.resource.data.flat == resource.data.flat
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['phone', 'residentType']));
        allow delete: if isAdmin();
      }

      // ── flats ──
      // SEC-06: restrict self-claim to approved fields; structural fields immutable
      match /flats/{flat} {
        allow read: if isMember();
        allow create: if isAdmin() || (signedIn() && !hasCfg());
        allow update: if isAdmin()
          || (isMember()
              && resource.data.claimedByUid == null
              && request.resource.data.claimedByUid == uid()
              && request.resource.data.isCommon == false
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['claimedByUid', 'name', 'meter']));
        allow delete: if isAdmin();
      }

      // ── water periods ── SEC-04: water role only
      match /waterPeriods/{p} {
        allow read: if isMember();
        allow write: if canEditWater() || (signedIn() && !hasCfg());
      }

      // ── maintenance periods ── SEC-04: treasurer role only
      match /maintPeriods/{p} {
        allow read: if isMember();
        allow write: if canEditMaint() || (signedIn() && !hasCfg());
      }

      // ── activities ── SEC-05: admin-only create/update/delete
      match /activities/{a} {
        allow read: if isMember();
        allow create: if isAdmin();
        // DB-09: restrict activity updates to admin (no broad member write)
        allow update: if isAdmin();
        allow delete: if isAdmin();

        // SEC-05 / FUNC-02: votes as subcollection, one doc per voter UID
        match /votes/{voterUid} {
          allow read: if isMember();
          allow create, update: if signedIn()
            && uid() == voterUid
            && isMember()
            && request.resource.data.keys().hasOnly(['optionIdx', 'flat', 'updatedAt'])
            && request.resource.data.optionIdx is int
            && request.resource.data.optionIdx >= 0
            && request.resource.data.flat is string;
          allow delete: if signedIn() && (uid() == voterUid || isAdmin());
        }
      }

      // ── cost presets ──
      match /costPresets/{p} {
        allow read: if isMember();
        // SEC-04: cost presets relate to water billing
        allow write: if canEditWater();
      }
    }
  }
}
