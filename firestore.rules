rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // ── /users/{u} ── SEC-01: owner-only, schema-validated ──
    match /users/{u} {
      allow read: if signedIn() && uid() == u;

      allow create: if signedIn()
        && uid() == u
        && request.resource.data.keys().hasOnly([
             'username',
             'buildings',
             'createdAt'
           ])
        && request.resource.data.username is string
        && request.resource.data.username.size() >= 1
        && request.resource.data.username.size() <= 50
        && request.resource.data.buildings is list
        && request.resource.data.buildings.size() == 0
        && request.resource.data.createdAt is int;

      allow update: if signedIn()
        && uid() == u
        && request.resource.data.keys().hasOnly([
             'username',
             'buildings',
             'createdAt'
           ])
        && request.resource.data.diff(resource.data)
             .affectedKeys()
             .hasOnly(['buildings'])
        && request.resource.data.username == resource.data.username
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.buildings is list
        && request.resource.data.buildings.size() <= 50;

      allow delete: if false;
    }

    // ── SEC-03: public building discovery (name, city, state only) ──
    match /publicBuildings/{bid} {
      allow read: if true;
      // Create: allowed during building creation batch (building doc exists after commit)
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'city', 'state', 'type'])
        && request.resource.data.name is string
        && existsAfter(/databases/$(database)/documents/buildings/$(bid))
        && getAfter(/databases/$(database)/documents/buildings/$(bid)).data.adminUid == request.auth.uid;
      // Update/delete: only building admin
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'city', 'state'])
        && exists(/databases/$(database)/documents/buildings/$(bid))
        && (request.auth.uid == get(/databases/$(database)/documents/buildings/$(bid)).data.adminUid
            || get(/databases/$(database)/documents/buildings/$(bid)/members/$(request.auth.uid)).data.roles.hasAny(['admin']));
      allow delete: if signedIn()
        && exists(/databases/$(database)/documents/buildings/$(bid))
        && (request.auth.uid == get(/databases/$(database)/documents/buildings/$(bid)).data.adminUid
            || get(/databases/$(database)/documents/buildings/$(bid)/members/$(request.auth.uid)).data.roles.hasAny(['admin']));
    }

    // ── /buildings/{bid} ──
    match /buildings/{bid} {
      function cfg() { return get(/databases/$(database)/documents/buildings/$(bid)).data; }
      function hasCfg() { return exists(/databases/$(database)/documents/buildings/$(bid)); }
      function isMember() { return signedIn() && exists(/databases/$(database)/documents/buildings/$(bid)/members/$(uid())); }
      function memberData() { return get(/databases/$(database)/documents/buildings/$(bid)/members/$(uid())).data; }
      function myRoles() { return memberData().roles; }
      function isAdmin() { return signedIn() && hasCfg() && (uid() == cfg().adminUid || (isMember() && myRoles().hasAny(['admin']))); }

      // SEC-11: distinguish guest members from full residents. Guests
      // must not receive private building config, member lists, flats,
      // water/maintenance data, or full event financials.
      function isGuest() { return isMember() && memberData().residentType == 'guest'; }
      function isResidentMember() {
        return isMember() && (memberData().residentType == 'owner' || memberData().residentType == 'tenant');
      }

      // SEC-04: role-specific edit helpers
      function hasRole(role) { return isMember() && myRoles().hasAny([role]); }
      function canEditWater() { return isAdmin() || hasRole('water'); }
      function canEditMaint() { return isAdmin() || hasRole('treasurer'); }
      function canCreateEventSummary() { return isAdmin() || hasRole('treasurer'); }

      // Item 6: allow child creation during atomic building setup batch
      function cfgAfter() {
        return getAfter(
          /databases/$(database)/documents/buildings/$(bid)
        ).data;
      }
      function isCreatingBuildingAsAdmin() {
        return signedIn()
          && existsAfter(
               /databases/$(database)/documents/buildings/$(bid)
             )
          && cfgAfter().adminUid == uid();
      }

      // DB-09: shared validation helpers
      function validRoles(roles) {
        return roles is list
          && roles.hasOnly(['admin', 'treasurer', 'water']);
      }
      function validResidentType(value) {
        return value == 'owner' || value == 'tenant' || value == 'guest';
      }

      // SEC-11: private building config readable only by resident members / admin.
      // Guests must not receive inviteCode, payments, outstanding, or other
      // private fields — they read publicBuildings/{bid} for display name only.
      allow get: if isResidentMember() || isAdmin();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.adminUid == uid();
      allow update, delete: if isAdmin();

      // ── members ──
      match /members/{m} {
        // Item 5: member document shape validation
        function validMemberShape(data) {
          return data.keys().hasOnly([
              'username',
              'flat',
              'roles',
              'residentType',
              'phone',
              'joinedAt'
            ])
            && data.username is string
            && data.username.size() >= 1
            && data.username.size() <= 50
            && data.roles is list
            && validRoles(data.roles)
            && validResidentType(data.residentType)
            && data.joinedAt is int;
        }

        function selfProfileUpdate() {
          return signedIn()
            && uid() == m
            && request.resource.data.roles == resource.data.roles
            && request.resource.data.flat == resource.data.flat
            && request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['phone', 'residentType'])
            && validResidentType(request.resource.data.residentType);
        }

        function selfFlatAssignment() {
          return signedIn()
            && uid() == m
            && resource.data.flat == null
            && request.resource.data.flat is string
            && request.resource.data.diff(resource.data)
                 .affectedKeys()
                 .hasOnly(['flat', 'residentType', 'phone'])
            && validResidentType(request.resource.data.residentType)
            && getAfter(
                 /databases/$(database)/documents/buildings/$(bid)/flats/$(request.resource.data.flat)
               ).data.claimedByUid == uid();
        }

        // SEC-11: resident members and admin can list/read the full member
        // roster; a guest can only read their own membership document.
        allow get: if isResidentMember() || isAdmin() || (isMember() && uid() == m);
        allow list: if isResidentMember() || isAdmin();

        // SEC-10: browser clients may NOT self-create membership.
        // Invited residents are created by the trusted /api/join-building
        // endpoint; guest memberships are created by /api/join-building-guest.
        // Founder membership is created in the atomic building-setup batch.
        // Admins can add members directly.
        allow create: if validMemberShape(request.resource.data)
          && (isAdmin() || isCreatingBuildingAsAdmin());

        allow update: if (
            isAdmin()
            && validRoles(request.resource.data.roles)
          )
          || selfProfileUpdate()
          || selfFlatAssignment();

        allow delete: if isAdmin();
      }

      // ── flats ── SEC-11: guests must not see flat/meter data.
      match /flats/{flat} {
        allow read: if isResidentMember() || isAdmin();
        allow create: if isAdmin() || isCreatingBuildingAsAdmin();
        allow update: if isAdmin()
          || (isResidentMember()
              && resource.data.claimedByUid == null
              && request.resource.data.claimedByUid == uid()
              && request.resource.data.isCommon == false
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['claimedByUid', 'name', 'meter']));
        allow delete: if isAdmin();
      }

      // ── water periods ── SEC-11: residents only.
      match /waterPeriods/{p} {
        allow read: if isResidentMember() || isAdmin();
        allow create: if canEditWater() || isCreatingBuildingAsAdmin();
        allow update, delete: if canEditWater();
      }

      // ── maintenance periods ── SEC-11: residents only.
      match /maintPeriods/{p} {
        allow read: if isResidentMember() || isAdmin();
        allow create: if canEditMaint() || isCreatingBuildingAsAdmin();
        allow update, delete: if canEditMaint();
      }

      // ── activities ── SEC-05 + Item 4: validated create and update
      match /activities/{a} {
        function validActivity(data) {
          return data.keys().hasOnly([
               'type', 'title', 'body', 'status', 'createdBy',
               'createdAt', 'updatedAt', 'poll', 'meeting', 'rich'
             ])
            && (
                 data.type == 'announcement'
                 || data.type == 'poll'
                 || data.type == 'meeting'
               )
            && data.title is string
            && data.title.size() >= 1
            && data.title.size() <= 150
            && data.body is string
            && data.body.size() <= 5000
            && (data.rich == null || data.rich is map)
            && data.createdBy is string
            && data.createdAt is int
            && data.updatedAt is int;
        }

        allow read: if isMember();

        allow create: if isAdmin()
          && validActivity(request.resource.data);

        // Item 4: validate updates + protect createdBy and createdAt
        allow update: if isAdmin()
          && validActivity(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if isAdmin();

        // SEC-05 / FUNC-02: votes subcollection
        // Item 2: handle null flat; Item 3: validate updatedAt type
        match /votes/{voterUid} {
          function activityData() {
            return get(
              /databases/$(database)/documents/buildings/$(bid)/activities/$(a)
            ).data;
          }
          function memberData() {
            return get(
              /databases/$(database)/documents/buildings/$(bid)/members/$(uid())
            ).data;
          }
          function validVote() {
            return request.resource.data.keys()
                     .hasOnly(['optionIdx', 'flat', 'updatedAt'])
              && request.resource.data.optionIdx is int
              && request.resource.data.optionIdx >= 0
              && activityData().type == 'poll'
              && activityData().poll.options is list
              && request.resource.data.optionIdx
                   < activityData().poll.options.size()
              && request.resource.data.flat is string
              && request.resource.data.flat
                   == (
                        memberData().flat == null
                          ? ''
                          : memberData().flat
                      )
              && request.resource.data.updatedAt is int;
          }

          allow read: if isMember();
          allow create, update: if signedIn()
            && uid() == voterUid
            && isMember()
            && validVote();
          // Item 7: simplified delete permission
          allow delete: if isAdmin()
            || (signedIn() && isMember() && uid() == voterUid);
        }
      }

      // ── cost presets ── SEC-11: residents only.
      match /costPresets/{p} {
        allow read: if isResidentMember() || isAdmin();
        allow write: if canEditWater();
      }

      // ── SEC-11: guest invitation tokens ──
      // Client-blocked entirely. Both /api/create-guest-invite and
      // /api/join-building-guest use the Admin SDK, which bypasses these
      // rules. Never expose stored token hashes to browser code.
      match /guestInvites/{inviteId} {
        allow read, write: if false;
      }

      // ── SEC-11: guest-safe event summary ──
      // Contains only display-safe fields (name, totals, counts, dates).
      // Guests read the summary instead of the full event document.
      // Residents and admin can also read it. Only treasurer/admin write.
      match /eventSummaries/{eid} {
        allow read: if isMember();
        allow create, update: if canCreateEventSummary();
        allow delete: if isAdmin();
      }

      // ── events (festival donations & expenses) ── all members may read.
      match /events/{eid} {
        function validEvent(data) {
          return data.keys().hasOnly([
               'name', 'year', 'status',
               'targetAmount', 'openingBalance', 'closingBalance',
               'donations', 'expenses', 'receivables',
               'createdAt', 'updatedAt', 'closedAt'
             ])
            && data.name is string
            && data.name.size() >= 1
            && data.name.size() <= 150
            && (data.status == 'active' || data.status == 'closed')
            && data.createdAt is int
            && data.updatedAt is int;
        }

        allow read: if isMember();

        allow create: if isAdmin()
          && validEvent(request.resource.data);

        allow update: if isAdmin()
          && validEvent(request.resource.data);

        allow delete: if isAdmin();
      }
    }
  }
}
